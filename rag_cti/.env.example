# Anthropic (required if GROQ_API_KEY is not set)
ANTHROPIC_API_KEY=sk-ant-...

# Groq — used for query generation in embedding bakeoff (preferred when set)
GROQ_API_KEY=gsk_...
GROQ_QUERY_MODEL=llama-3.1-8b-instant

# AlienVault OTX
OTX_API_KEY=...

# VirusTotal
VT_API_KEY=...

# LangSmith
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=rag-cti

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model selection: bge-m3 | gte-large | nomic-embed | voyage-2
EMBEDDING_MODEL=bge-m3

# Retrieval defaults
RETRIEVAL_TOP_K=10
HYBRID_ALPHA=0.5

# LLM tiers
LLM_ROUTING_MODEL=claude-haiku-4-5-20251001
LLM_ANALYSIS_MODEL=claude-sonnet-4-6
LLM_REPORT_MODEL=claude-opus-4-7

# Feature flags
HYDE_ENABLED=true
HYDE_MIN_QUERY_TOKENS=5
