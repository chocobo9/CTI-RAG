# Anthropic (required if GROQ_API_KEY is not set)
ANTHROPIC_API_KEY=sk-ant-...

# LLM: default is Groq API (set OLLAMA_ENABLED=true only for local Ollama).
OLLAMA_ENABLED=false

# Groq — primary API provider when GROQ_API_KEY is set (HyDE / generation)
GROQ_API_KEY=gsk_
GROQ_QUERY_MODEL=llama-3.1-8b-instant
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
GROQ_REPORT_MODEL=llama-3.3-70b-versatile

# AlienVault OTX
OTX_API_KEY= 

# VirusTotal
VT_API_KEY=...

# LangSmith
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=rag-cti

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model: Hugging Face repo id (e.g. BAAI/bge-m3) or local path. Bare "bge-m3" is invalid on the Hub.
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval defaults
RETRIEVAL_TOP_K=10
HYBRID_ALPHA=0.5

# LLM tiers
LLM_ROUTING_MODEL=claude-haiku-4-5-20251001
LLM_ANALYSIS_MODEL=claude-sonnet-4-6
LLM_REPORT_MODEL=claude-opus-4-7

# Reranker
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES_K=50

# Feature flags
HYDE_ENABLED=true
HYDE_MIN_QUERY_TOKENS=5
