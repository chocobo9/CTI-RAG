# Groq — primary LLM provider (HyDE / generation)
GROQ_API_KEY=gsk_
GROQ_QUERY_MODEL=llama-3.1-8b-instant
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
GROQ_REPORT_MODEL=llama-3.3-70b-versatile

# Anthropic (optional fallback if GROQ_API_KEY is not set)
ANTHROPIC_API_KEY=
# Model used by HyDE when the Anthropic client is active
LLM_ROUTING_MODEL=claude-haiku-4-5-20251001

# Ollama (local) — set true to use a local OpenAI-compatible Ollama instead
OLLAMA_ENABLED=false

# DeepSeek (RAGAS judge LLM; also usable as annotator via --provider deepseek)
DEEPSEEK_API_KEY=

# AlienVault OTX
OTX_API_KEY=

# VirusTotal
VT_API_KEY=

# Whoxy — WHOIS lookups for scripts/fetch_whois.py
WHOXY_API_KEY=


#Abuse.ch Auth-key
ABUSECH_AUTH_KEY=

# Passive DNS — PLACEHOLDER: no provider wired yet. scripts/refetch_pdns_raw.py
# is structurally complete but needs a provider endpoint + this key to run.
PDNS_API_KEY=

# LangSmith (optional tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-cti

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cti_chunks

# Embedding model: Hugging Face repo id (e.g. BAAI/bge-m3) or local path. Bare "bge-m3" is invalid on the Hub.
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval defaults
RETRIEVAL_TOP_K=10
# Dense weight in the weighted-RRF fusion (sparse gets 1 - alpha); >=1.0 = pure dense.
HYBRID_ALPHA=0.5

# Reranker
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES_K=50

# Feature flags
HYDE_ENABLED=true
HYDE_MIN_QUERY_TOKENS=5
