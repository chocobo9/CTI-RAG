{"count": 579, "results": [{"id": "64e85651d0223edd70e1f92a", "name": "From Conti to Akira | Decoding the Latest Linux & ESXi Ransomware Families", "description": "", "author_name": "tr2222200", "modified": "2023-08-28T05:48:39.556000", "created": "2023-08-25T07:20:49.729000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "tr2222200", "id": "207905", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "64c11b20713f2ef9c8dbb9b8", "name": "Akira Ransomware", "description": "Akira ransomware, similar to other types of ransomware, spreads within a corporate network and targets multiple devices once it gains access. However, before encrypting files, the ransomware avoids certain folders, including Recycle Bin, System Volume Information, Boot, ProgramData, and Windows, as well as specific Windows system files with .exe, .lnk, .dll, .msi, and .sys extensions.", "author_name": "AlienVault", "modified": "2023-08-25T05:02:24.361000", "created": "2023-07-26T13:09:52.785000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 6, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "64c0b29928f71581e278aab6", "name": "Akira Ransomware", "description": "Akira ransomware, similar to other types of ransomware, spreads within a corporate network and targets multiple devices once it gains access. However, before encrypting files, the ransomware avoids certain folders, including Recycle Bin, System Volume Information, Boot, ProgramData, and Windows, as well as specific Windows system files with .exe, .lnk, .dll, .msi, and .sys extensions.", "author_name": "aa00643640@techmahindra.com", "modified": "2023-08-25T05:02:24.361000", "created": "2023-07-26T05:43:53.418000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "aa00643640@techmahindra.com", "id": "156540", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "64e69adc2d06aa3575b6fa9d", "name": "From Conti to Akira | Decoding the Latest Linux & ESXi Ransomware Families", "description": "", "author_name": "CyberHunterAutoFeed", "modified": "2023-08-23T23:48:44.191000", "created": "2023-08-23T23:48:44.191000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 1, "groups": [], "in_group": false, "author": {"username": "CyberHunterAutoFeed", "id": "182496", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_182496/resized/80/avatar_3b9c358f36.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "64e65450b820f91f4fd1ac72", "name": "From Conti to Akira | Decoding the Latest Linux & ESXi Ransomware Families", "description": "", "author_name": "feisty-swim1410", "modified": "2023-08-23T18:47:44.410000", "created": "2023-08-23T18:47:44.410000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "feisty-swim1410", "id": "217462", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "64e64d4f3fbd8deafea68166", "name": "From Conti to Akira | Decoding the Latest Linux & ESXi Ransomware Families", "description": "Strategically dipping into code from well-known ransomware families such as Conti, Babuk, or Lockbit, ransomware operators are reusing and modifying codebases to create novel attack techniques. As more cases of this come to light, it is critical for security teams to stay vigilant and adaptive in their defenses.", "author_name": "AlienVault", "modified": "2023-08-23T18:17:51.078000", "created": "2023-08-23T18:17:51.078000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "64d36373ed245891155e0c25", "name": "Akira Ransomware New IOCs", "description": "New IOCs after July 5, 23. Akira is a ransomware family that was first discovered in March 2023. It primarily targets Windows systems but has recently expanded its target footprint to include Linux systems, specifically VMware ESXi servers. The malware uses a symmetric key generated by CryptGenRandom, which is then encrypted by an RSA-4096 public key and appended to the end of an encrypted file. Akira is known for its double-extortion technique, where it exfiltrates victim data before encrypting it and threatens to leak the stolen data if the ransom is not paid. The group behind Akira has claimed successful attacks on various organizations in multiple industries, including education, finance, real estate, and manufacturing.", "author_name": "almendra", "modified": "2023-08-09T09:59:15.265000", "cr