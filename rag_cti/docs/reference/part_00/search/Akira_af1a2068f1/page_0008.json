9:22.743000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "LTNA-Australia", "id": "380633", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_380633/resized/80/avatar_3b9c358f36.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "69bad8208e4eedb7123ebbce", "name": "Ransomware Under Pressure: Tactics, Techniques, and Procedures in a Shifting Threat Landscape", "description": "The ransomware landscape in 2025 reflects a continued evolution marked by significant changes in tactics, techniques, and procedures (TTPs) used by threat actors. Ransomware attacks, particularly through Ransomware-as-a-Service (RaaS) models, remain a prominent threat, with the REDBIKE family leading in prevalence, accounting for nearly 30% of incidents. The shift towards data theft extortion has intensified, highlighted by 77% of ransomware incidents involving suspected data theft, an increase from previous years. Threat actors increasingly target vulnerabilities in common services like VPNs and firewalls-namely, those from Fortinet, SonicWall, and Palo Alto-often employing sophisticated methods, including zero-day exploits, to gain initial access.", "author_name": "PetrP.73", "modified": "2026-03-18T16:51:44.127000", "created": "2026-03-18T16:51:44.127000", "tags": [], "references": [], "public": 1, "adversary": "Threat", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 1, "groups": [], "in_group": false, "author": {"username": "PetrP.73", "id": "154605", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}], "exact_match": "", "previous": "https://otx.alienvault.com/api/v1/search/pulses?q=Akira&page=7&li