{"count": 74, "results": [{"id": "667a5f649409ef003ecf75a3", "name": "SmallTiger Malware Used in Attacks Against South Korean Businesses (Kimsuky and Andariel)", "description": "", "author_name": "Tr1sa111", "modified": "2024-07-11T10:00:12.090000", "created": "2024-06-25T06:10:44.154000", "tags": [], "references": [], "public": 1, "adversary": "Kimsuky and Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "Tr1sa111", "id": "192483", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "667283e9c7683221cd83e3ac", "name": "SmallTiger Malware Used in Attacks Against South Korean Businesses (Kimsuky and Andariel)", "description": "", "author_name": "tr2222200", "modified": "2024-07-11T10:00:12.090000", "created": "2024-06-19T07:08:25.713000", "tags": [], "references": [], "public": 1, "adversary": "Kimsuky and Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "tr2222200", "id": "207905", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "66682128fc1e476843d5fa28", "name": "SmallTiger Malware Used in Attacks Against South Korean Businesses (Kimsuky and Andariel)", "description": "This report details a series of attacks targeting South Korean companies, particularly defense contractors, automobile part manufacturers, and semiconductor manufacturers. The threat actor initially deployed malware strains associated with the Kimsuky group, such as MultiRDP and Meterpreter, but later switched to using a downloader named SmallTiger. The final payload in the earlier attacks was DurianBeacon, a backdoor malware previously used by the Andariel group. The SmallTiger downloader was employed to download additional payloads, including information stealers and credential harvesters like Mimikatz and WebBrowserPassView. The attacks began in November 2023 and were ongoing as of May 2024, with the threat actor leveraging various distribution methods such as software updaters, mshta, and even GitHub.", "author_name": "AlienVault", "modified": "2024-07-11T10:00:12.090000", "created": "2024-06-11T10:04:24.062000", "tags": [], "references": [], "public": 1, "adversary": "Kimsuky and Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 4, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "6667f3d24fa81c41bcb3e898", "name": "SmallTiger Malware Used in Attacks Against South Korean Businesses (Kimsuky and Andariel) - ASEC BLOG", "description": "", "author_name": "CyberHunter_NL", "modified": "2024-07-11T06:04:03.371000", "created": "2024-06-11T06:50:58.260000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "CyberHunter_NL", "id": "171283", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_171283/resized/80/avatar_3b9c358f36.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "667a56f2da8692db36d4167d", "name": "Analysis of APT Attack Cases Using Dora RAT Against Korean Companies (Andariel Group)", "description": "", "author_name": "Tr1sa111", "modified": "2024-06-29T15:00:42.996000", "created": "2024-06-25T05:34:42.407000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "Tr1sa111", "id": "192483", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "6661327bec40f67b27556edd", "name": "Analysis of APT Attack Cases Using Dora RAT Against Korean Companies (Andariel Group)", "description": "", "author_name": "tr2222200", "modified": "2024-06-29T15:00:42.996000", "created": "2024-06-06T03:52:27.123000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "tr2222200", "id": "207905", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "66589d33a96bf02edf2838f4", "name": "Analysis of APT Attack Cases Using Dora RAT Against Companies", "description": "This analysis discusses an APT campaign by the Andariel threat group targeting Korean companies and educational institutions. The campaign employed various malware strains, including Nestdoor backdoor, Dora RAT, keyloggers, infostealers, and proxy tools. The attackers exploited vulnerabilities, such as Apache Tomcat and VMware Horizon's Log4Shell, for initial access and malware distribution. The report provides technical details on the malware strains, Command and Control infrastructure, and tactics utilized by the threat actors.", "author_name": "AlienVault", "modified": "2024-06-29T15:00:42.996000", "created": "2024-05-30T15:37:22.555000", "tags": [], "references": [], "public": 1, "adversary": "Lazarus Group", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 