, "modified": "2024-06-20T01:03:51.062000", "created": "2024-05-21T01:45:53.247000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "cryptocti", "id": "110256", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_110256/resized/80/avatar_e237a4257c.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "6666a712d10949dfbb40032c", "name": "Analysis of APT attack cases targeting domestic companies using Dora RAT (Andariel Group)", "description": "", "author_name": "Tr1sa111", "modified": "2024-06-19T10:00:57.752000", "created": "2024-06-10T07:11:14.517000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "Tr1sa111", "id": "192483", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "66540dec3f58109c4034f8c4", "name": "Analysis of APT attack cases targeting domestic companies using Dora RAT (Andariel Group)", "description": "", "author_name": "tr2222200", "modified": "2024-06-19T10:00:57.752000", "created": "2024-05-27T04:37:00.493000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "tr2222200", "id": "207905", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "664b23ed2edf951c5a86b075", "name": "Analysis of APT attack cases targeting domestic companies using Dora RAT (Andariel Group)", "description": "AhnLab Security Intelligence Center (ASEC) recently confirmed that the Andariel group carried out APT attacks on domestic companies and institutions. The targeted organizations included manufacturing companies, construction firms, and educational institutions. The attackers employed backdoors, keyloggers, infostealers, and proxy tools to control the infected systems and steal data.\n\nIn this attack, malicious codes previously associated with the Andariel group were identified, such as Nestdoor, a backdoor malware. Additionally, web shells were detected. Although not identical, the proxy tool used in past Lazarus group attacks was also employed in this incident.", "author_name": "AlienVault", "modified": "2024-06-19T10:00:57.752000", "created": "2024-05-20T10:20:28.411000", "tags": [], "references": [], "public": 1, "adversary": "Lazarus Group", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "664730a8a9a7c44987d90234", "name": "Dora RAT\uc744 \uc774\uc6a9\ud55c \uad6d\ub0b4 \uae30\uc5c5 \ub300\uc0c1 APT \uacf5\uaca9 \uc0ac\ub840 \ubd84\uc11d (Andariel \uadf8\ub8f9) - ASEC BLOG", "description": "Dora RAT, Andariel \uadf8\ub8f9 (APT)  \u00c2\u00a31.5m,  is the latest security alert to hit South Korea.", "author_name": "bluenumberone", "modified": "2024-06-16T10:04:57.524000", "created": "2024-05-17T10:25:44.713000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "bluenumberone", "id": "246058", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "660282819feafb687d675614", "name": "Andariel Group Exploiting Korean Asset Management Solutions (MeshAgent)", "description": "", "author_name": "Tr1sa111", "modified": "2024-04-18T13:02:54.232000", "created": "2024-03-26T08:08:33.652000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "Tr1sa111", "id": "192483", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "65fc99d2837820ab3cd46266", "name": "Andariel Group Exploiting Korean Asset Management Solutions (MeshAgent)", "description": "", "author_name": "tr2222200", "modified": "2024-04-18T13:02:54.232000", "created": "2024-03-21T20:34:26.925000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "tr2222200", "id": "207905", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "65f98cc24ac62ec6d1ea3fff", "name": "Exploiting Korean Asset Management Solutions (MeshAgent)", "description": "The Andariel group exploited Korean asset management solutions to install malware such as AndarLoader and ModeLoader. The group used solutions like MeshAgent for remote control. They installed backdoors, took control of systems, and stole credentials.", "author_name": "AlienVault", "modified": "2024-04-18T13:02:54.232000", "created": "2024-03-19T13:01:54.804000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 2, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "65f94c4aa5853abedf7de998", "name": "Andariel Group Exploiting Korean Asset Management Solutions (MeshAgent) - ASEC BLOG", "description": "The Andariel group, a group of cyber-thieves, has been exploiting Korean asset management solutions to install malware that can be used to control their victims' screens, according to AhnLab SEcurity.", "author_name": "CyberHunter_NL", "modified": "2024-04-18T08:01:12.993000", "created": "2024-03-19T08:26:50.776000", "tags": [], "references": [], "public": 1, "adversary": "Andariel", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "CyberHunter_NL", "id": "171283", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_171283/resized/80/avatar_3b9c358f36.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "656df70873f5a2a602eb5734", "name": "Circumstances of the Andariel Group Exploiting an Apache ActiveMQ Vulnerability (CVE-2023-46604) ", "description": "", "author_name": "scoreblue", "modified": "2023-12-27T20:01:16.346000", "created": "2023-12-04T15:58:00.145000", "tags": [], "references": [], "public": 1, "adversary": "Lazarus", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "scoreblue", "id": "254100", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_254100/resized/80/avatar_3b9c358f36.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "6564f921500ae6dab82c3bea", "name": "Circumstances of the Andariel Group Exploiting an Apache ActiveMQ Vulnerability (CVE-2023-46604) - ASEC BLOG", "description": "The Andariel threat group is suspected of exploiting a remote code execution vulnerability in Apache ActiveMQ to install malware, including the HelloKitty ransomware, and TigerRat backdoors, in South Korea.", "author_name": "Superpro", "modified": "2023-12-27T20:01:16.346000", "created": "2023-11-27T20:16:33.510000", "tags": [], "references": [], "public": 1, "adversary": "Lazarus", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "Superpro", "id": "61676", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}], "exact_match": "", "previous": "https://otx.alienvault.com/api/v1/search/pulses?q=Andariel&page=1&limit=20&sort=-modified", "next": "https://otx.alienvault.com/api/v1/search/pulses?q=Andariel&page=3&limit=20&sort=-modified"}