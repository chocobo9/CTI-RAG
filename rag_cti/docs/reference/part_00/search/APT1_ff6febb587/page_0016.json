{"count": 313, "results": [{"id": "58eba6db5f843938240a4d13", "name": "Red Leaves Implant - overview", "description": "This technical note discusses a relatively undocumented implant used by the APT10 group. This is named \u201cRed Leaves\u201d after strings found in the malware. The sample discussed was found during an incident response engagement in March 2017. The earliest evidence obtained shows it has been in use since at least November 2016.", "author_name": "AlienVault", "modified": "2017-07-21T16:32:16.423000", "created": "2017-04-10T15:38:03.076000", "tags": [], "references": [], "public": 1, "adversary": "Stone Panda", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "59708e252d213714b25a855f", "name": "APT17", "description": "this is just test", "author_name": "ayakhalid", "modified": "2017-07-20T11:04:05.991000", "created": "2017-07-20T11:04:05.991000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 1, "groups": [], "in_group": false, "author": {"username": "ayakhalid", "id": "37181", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "59134ad9cbbd38106f22089c", "name": "APT10  - Pastebin.com", "description": "", "author_name": "KonstantinJM", "modified": "2017-05-10T17:16:09.588000", "created": "2017-05-10T17:16:09.588000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "KonstantinJM", "id": "17354", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_17354/resized/80/avatar_99bf8521b6.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "58e3311bbd0e9641d84693a9", "name": "APT10(a.k.a. StonePanda, menupass) infrastructure", "description": "", "author_name": "jaPwN", "modified": "2017-04-04T08:34:21.475000", "created": "2017-04-04T05:37:31.927000", "tags": [], "references": [], "public": 1, "adversary": "https://www.pwc.co.uk/issues/cyber-security-data-privacy/insights/operation-cloud-hopper.html", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 4, "groups": [], "in_group": false, "author": {"username": "jaPwN", "id": "21081", "avatar_url": "/otxapi/users/avatar_image/media/avatars/jaPwN/resized/80/japwn.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "58e28de6bd0e9607094693a9", "name": "Operation Cloud Hopper", "description": "The espionage campaign has targeted managed IT service providers (MSPs), allowing the APT10 group unprecedented potential access to the intellectual property and sensitive data of those MSPs and their clients globally. This indirect approach of reaching many through only a few targets demonstrates a new level of maturity in cyber espionage \u2013 so it\u2019s more important than ever to have a comprehensive view of all the threats your organisation might be exposed to, either directly or through your supply chain.", "author_name": "zer0daydan", "modified": "2017-04-03T18:15:33.720000", "created": "2017-04-03T18:01:10.379000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 35, "groups": [], "in_group": false, "author": {"username": "zer0daydan", "id": "10931", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_10931/resized/80/avatar_645faabb2e.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "58d07c6cf837f01c3ea3bc69", "name": "APT10 Indicators", "description": "Indicators for MenuPass/APT10", "author_name": "AlienVault", "modified": "2017-03-21T01:05:48.809000", "created": "2017-03-21T01:05:48.809000", "tags": [], "references": [], "public": 1, "adversary": "APT10", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "58cdce9a05e7850461c2fac1", "name": "A Detailed Examination of the Siesta Campaign (2014)", "description": "FireEye recently looked deeper into the activity discussed in TrendMicro\u2019s blog and dubbed the \u201cSiesta\u201d campaign. The tools, modus operandi, and infrastructure used in the campaign present two possibilities: either the Chinese cyber-espionage unit APT1 is perpetrating this activity, or another group is using the same tactics and tools as the legacy APT1.\n\nThe Siesta campaign reinforces the fact that analysts and network defenders should remain on the lookout for known, public indicators and for shared attributes that allow security experts to detect multiple actors with one signature.", "author_name": "nightingale", "modified": "2017-03-19T00:19:38.945000", "created": "2017-03-19T00:19:38.945000", "tags": [], "references": [], "public": 1, "adversary": "Comment Crew", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "revision": 1, "groups": [], "in_group": false, "author": {"username": "nightingale", "id": "25380", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_25380/resized/80/avatar_468b7010b8.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "58863b38bcce72018c5cfaae", "name": "Targeted Attacks  - Fake Japan Society for the Promotion of Science  and... by APT10?", "description": "", "author_name": "jaPwN", "modified": "2017-02-23T17:23:49.528000", "created": "2017-01-23T17:19:52.255000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 22, "groups": [], "in_group": false, "author": {"username": "jaPwN", "id": "21081", "avatar_url": "/otxapi/users/avatar_image/media/avatars/jaPwN/resized/80/japwn.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "588a4167aa33e36ce7dc71b9", "name": "Spearphishing campaign targeting Japan - ChChes/APT10", "description": "JPCERT / CC confirms that a targeted mail with a ZIP file containing an executable file has been sent to domestic organizations around October 2016. Targeted e-mails are cheating real people and are sent from domestic free e-mail addresses. Also, the executable file is encoded in the Word document as an icon, and when it is executed it infects the system with a malware called ChChes.", "author_name": "AlienVault", "modified": "2017-01-26T18:35:59.972000", "created": "2017-01-26T18:35:19.131000", "tags": [], "references": [], "public": 1, "adversary": "APT10", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 2, "groups": [], "in_group": false, "author": {"username": "AlienVault", "id": "2", "avatar_url": "/otxapi/users/avatar_image/media/avatars/user_2/resized/80/avatar_dacfad0ca8.png", "is_subscribed": true, "is_following": false}, "is_subscribing": null}, {"id": "57e8993d88f82a1da07c6191", "name": "Mandiant APT1 IOC", "description": "3000 indicators - APT1 is one of dozens of threat groups Mandiant tracks around the world and we consider it to be one of the most prolific in terms of the sheer quantity of information it has stolen.", "author_name": "nelsonmaligro", "modified": "2016-09-26T22:30:58.901000", "created": "2016-09-26T03:42:53.464000", "tags": [], "references": [], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 5, "groups": [], "in_group": false, "author": {"username": "nelsonmaligro", "id": "17742", "avatar_url": "/otxapi/users/avatar_image/media/avatars/nelsonmaligro/resized/80/Lapulau.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "56aa5a2f67db8c6aaee0222a", "name": "COOKIEBAG (FAMILY)", "description": "This family of malware is a backdoor capable of file upload and download as well as providing remote interactive shell access to the compromised machine.\nCommunication with the Command & Control (C2) servers uses a combination of single-byte XOR and Base64 encoded data in the Cookie and Set-Cookie HTTP header fields. Communication with the C2 servers is over port 80. Some variants install a registry key as means of a persistence mechanism. The hardcoded strings cited include a string of a command in common with several other APT1 families.", "author_name": "alozovyy", "modified": "2016-01-28T18:13:03.143000", "created": "2016-01-28T18:13:03.143000", "tags": [], "references": [], "public": 1, "adversary": null, "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 1, "groups": [], "in_group": false, "author": {"username": "alozovyy", "id": "9595", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "56aa59de67db8c6aaee020ad", "name": "Appendix E - APT1 File Hashes", "description": "MD5 Hashes from APT 1 malware", "author_name": "alozovyy", "modified": "2016-01-28T18:11:41.995000", "created": "2016-01-28T18:11:41.995000", "tags": [], "references": [], "public": 1, "adversary": null, "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 1, "groups": [], "in_group": false, "author": {"username": "alozovyy", "id": "9595", "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png", "is_subscribed": false, "is_following": false}, "is_subscribing": null}, {"id": "55aea128b45ff5345f94e69d", "name": "DEMONSTRATING HUSTLE - APT18 (BLOG)", "description": "This IOC contains indicators detailed in the blog post \"Demonstrating Hustle\" that can be read here: https://www.fireeye.com/blog/threat-research/2015/07/demonstrating_hustle.html. This IOC contains indicators for a spearphishing campaign carried out by APT18.", "author_name": "Garrett", "modified": "2015-07-21T19:44:40.162000", "created": "2015-07-21T19:44:40.162000", "tags": [], "references": [], "public": 1, "adversary": null, "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "green", "revision": 1, "groups": [], "in_group": false, "author": {"username": "Garrett", "id": "28", "avatar_url": "/otxapi/users/avatar_image/media/avatars/Garrett/resized/80/capn-crunch whistle.jpg", "is_subscribed": false, "is_following": false}, "is_subscribing": null}], "exact_match": "", "previous": "https://otx.alienvault.com/api/v1/search/pulses?q=APT1&page=15&limit=20&sort=-modified", "next": null}