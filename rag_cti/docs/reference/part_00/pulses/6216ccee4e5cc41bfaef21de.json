{"id": "6216ccee4e5cc41bfaef21de", "name": "China-Backed APT10 Targeted Taiwanese Financial Firms", "description": "According to the security firm CyCraft,\u00a0China's state-sponsored APT10 conducted a two-month campaign against Taiwanese financial services firms.\u00a0CyCraft's analysis\u00a0of the incident alleges that the attack\u00a0used supply chain attacks to target software used by Taiwanese financial institutions.\n\nThe attackers first breached the software systems using a web service vulnerability present in security software, then deployed QuasarRAT and used it to download other malware payloads.\u00a0CyCraft suggests that attackers were trying to steal financial information as the RAT is an open-source tool that can capture screenshots, edit registry, record webcam, steal passwords, and perform keylogging.", "author_name": "Superpro", "modified": "2022-03-26T00:05:56.150000", "created": "2022-02-24T00:10:22.732000", "tags": ["c2 server", "dotnet", "strong", "cycraft", "dotnet library", "operation cache", "panda", "webshell", "dotnet assembly", "resolve", "shellcode", "donut", "quasar", "quasar rat", "quasarrat", "assembly", "sharpsploit", "loader", "defender", "fast"], "references": ["https://medium.com/cycraft/supply-chain-attack-targeting-taiwan-financial-sector-bae2f0962934"], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "indicators": [{"id": 3382091119, "indicator": "03b88fd80414edeabaaa6bb55d1d09fc", "type": "FileHash-MD5", "created": "2022-02-24T00:10:23", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 3382091120, "indicator": "0724ac34e997354ca9fb06d57af4e29b", "type": "FileHash-MD5", "created": "2022-02-24T00:10:23", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 3382091121, "indicator": "165758ba40b3cc965d98c1fde2d56798", "type": "FileHash-MD5", "created": "2022-02-24T00:1