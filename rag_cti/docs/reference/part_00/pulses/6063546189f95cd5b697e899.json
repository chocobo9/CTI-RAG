{"id": "6063546189f95cd5b697e899", "name": "APT10: Sophisticated Multi-Layered Loader Ecipekac Discovered in A41APT Campaign", "description": "A41APT is a long-running campaign with activities detected from March 2019 to the end of December 2020. Most of the discovered malware families are fileless malware and they have not been seen before. One particular piece of malware from this campaign is called Ecipekac (a.k.a DESLoader, SigLoader, and HEAVYHAND). It is a very sophisticated multi-layer loader module used to deliver payloads such as SodaMaster (a.k.a DelfsCake, dfls, and DARKTOWN), P8RAT (a.k.a GreetCake, and HEAVYPOT) and FYAnti (a.k.a DILLJUICE stage2) which loads QuasarRAT.", "author_name": "AlienVault", "modified": "2021-04-29T00:03:01.245000", "created": "2021-03-30T16:40:00.960000", "tags": ["A41APT", "APT10", "Ecipekac", "DESLoader", "SigLoader", "HEAVYHAND", "SodaMaster", "DelfsCake", "DARKTOWN", "GreetCake", "HEAVYPOT", "FYAnti", "DILLJUICE", "QuasarRAT", "P8RAT"], "references": ["https://securelist.com/apt10-sophisticated-multi-layered-loader-ecipekac-discovered-in-a41apt-campaign/101519/"], "public": 1, "adversary": "A41APT", "targeted_countries": ["Japan", "Turkey"], "malware_families": ["Ecipekac", "DESLoader", "SigLoader", "HEAVYHAND", "SodaMaster", "DelfsCake", "DARKTOWN", "P8RAT", "GreetCake", "HEAVYPOT", "FYAnti", "DILLJUICE", "QuasarRAT - S0262"], "attack_ids": ["T1027", "T1553", "T1102", "T1573", "T1140", "T1566", "T1055", "T1547", "T1012", "T1036", "T1053", "T1057", "T1059", "T1070", "T1071", "T1078", "T1082", "T1132", "T1133", "T1210", "T1497", "T1574"], "industries": ["Finance", "Telecommunications"], "TLP": "white", "indicators": [{"id": 2834832074, "indicator": "019619318e1e3a77f3071fb297b85cf3", "type": "FileHash-MD5", "created": "2021-03-30T16:40:02", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 2834832076, "indicator": "335ce825da93ed3fdd4470634845dfea", "type": "FileHash-MD5", "created":