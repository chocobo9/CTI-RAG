{"id": "5b02d669f283a83d0cc4e7b5", "name": "APT10 Using Cobalt Strike and Continuing to Target UK", "description": "APT10 (also known as Stone Panda, MenuPass and Red Apollo) is a threat actor known to have been active since at least 2009. Since then it has targeted healthcare, defence, aerospace, government, heavy industry/mining, Managed Service Providers (MSPs) and IT industries, among many other sectors, for the likely purpose of intellectual property theft. In 2017 its targeting of several global MSPs, giving it extensive access to the networks of organisations worldwide, was widely reported by the NCSC and industry partners.", "author_name": "AlienVault", "modified": "2019-01-17T17:57:53.747000", "created": "2018-05-21T14:23:37.252000", "tags": [], "references": ["https://www.lac.co.jp/lacwatch/people/20180521_001638.html", "https://www.ncsc.gov.uk/alerts/apt10-continuing-target-uk-organisations"], "public": 1, "adversary": "APT10", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "indicators": [{"id": 919875944, "indicator": "http://www.jadl-or.com/webui.conf", "type": "URL", "created": "2018-05-21T14:23:38", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 919875945, "indicator": "https://www.jadl-or.com/webui.conf", "type": "URL", "created": "2018-05-21T14:23:38", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 919875946, "indicator": "www.jadl-or.com", "type": "hostname", "created": "2018-05-21T14:23:38", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 919875947, "indicator": "246cb77ecfd0a8e62b68c76be5a6ce5c", "type": "FileHash-MD5", "created": "2018-05-21T14:23:38", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 919875948, "indicator": "9a0b957f164508830342310c44d56e49", "type": "FileHash-MD5", "created": "2018-05-21T14:23:38", "cont