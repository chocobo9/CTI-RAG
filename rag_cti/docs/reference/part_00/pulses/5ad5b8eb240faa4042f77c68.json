{"id": "5ad5b8eb240faa4042f77c68", "name": "New surveillanceware in Google Play with ties to known threat actor targeting the Middle East", "description": "Lookout researchers have identified a new, highly targeted surveillanceware family known as Desert Scorpion in the Google Play Store. Lookout notified Google of the finding and Google removed the app immediately while also taking action on it in Google Play Protect. The app ties together two malware families - Desert Scorpion and another targeted surveillanceware family named FrozenCell - that we believe are being developed by a single, evolving surveillanceware actor called APT-C-23 targeting individuals in the Middle East.", "author_name": "AlienVault", "modified": "2018-04-17T09:05:46.690000", "created": "2018-04-17T09:05:46.690000", "tags": [], "references": ["https://blog.lookout.com/desert-scorpion-google-play"], "public": 1, "adversary": "", "targeted_countries": [], "malware_families": [], "attack_ids": [], "industries": [], "TLP": "white", "indicators": [{"id": 617160661, "indicator": "https://drive.google.com/uc?authuser=0&amp;id=1cHHFMm-NiJejIE4xZxXHKGGYtxti4Gjs&amp;export=download", "type": "URL", "created": "2018-04-17T09:05:48", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 617160662, "indicator": "https://doc-04-9g-docs.googleusercontent.com/docs/securesc/ha0ro937gcuc7l7deffksulhg5h7mbp1/khq1nnes98sbmo0hnca368hdr5d37lko/1521280800000/14075706053171650887/*/1cHHFMm-NiJejIE4xZxXHKGGYtxti4Gjs?e=download", "type": "URL", "created": "2018-04-17T09:05:48", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 575699984, "indicator": "dachfunny.club", "type": "domain", "created": "2018-04-17T09:05:48", "content": "", "title": "", "description": "", "expiration": null, "is_active": 1}, {"id": 575699979, "indicator": "dardash.fun", "type": "domain", "created": "2018-04-17T09:05:48", "content": "", "title": "", "description": "