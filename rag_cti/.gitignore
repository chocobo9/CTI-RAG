# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
cti-rag-venv/
# Environment / secrets
.env
.env.local
*.key

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
help/*

# Type checking / linting
.mypy_cache/
.ruff_cache/

# Data (raw feeds and processed outputs — never commit)
# Use data/raw/* (not data/raw/) so the PDF report corpus can be re-included:
# git cannot un-ignore a child of a fully-ignored directory.
data/raw/*
# PDF source reports are uploaded for team distribution (pdfs_bench stays ignored).
!data/raw/pdfs/
data/processed/*
# Shared corpus snapshots (whitelisted for team distribution)
!data/processed/mitre.jsonl
!data/processed/mitre_relationships.jsonl
!data/processed/otx.jsonl
!data/processed/pdfs.jsonl
data/migrate_dump.jsonl
# BM25 sparse vocab — base + per-collection variants (sparse_vocab_<collection>.json)
data/sparse_vocab*.json

# Eval data: ignored by default, but published artifacts (query sets,
# capability summary, attribution/RAGAS results, certification evidence the
# summary references) are whitelisted — Phase C/D results must be traceable.
# ctibench/ stays untracked: CC BY-NC-SA anchor data, copy locally.
data/eval/*
!data/eval/query_set_v*.jsonl
!data/eval/capabilities_summary.json
!data/eval/attribution_v3_results.json
!data/eval/ragas_v3_results.json
!data/eval/certification_*.json

# Notebooks — commit source; ignore kernel checkpoints only
notebooks/.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Development harness (RIE audit trails)
.harness/

# Ad-hoc helper scripts (not part of the public API)
scripts/_*.py

