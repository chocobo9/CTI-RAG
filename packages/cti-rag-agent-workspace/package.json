{
	"name": "@earendil-works/pi-cti-rag-agent-workspace",
	"version": "0.80.7",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx cp -r src/schemas dist/schemas",
		"smoke:opencti": "tsx src/node/opencti-case-smoke-cli.ts",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.80.7",
		"@earendil-works/pi-ai": "^0.80.7"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
